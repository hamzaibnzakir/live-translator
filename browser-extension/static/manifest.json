{
  "manifest_version": 3,
  "name": "Brainbox Translate",
  "short_name": "Brainbox",
  "description": "On-device, in-place translation for Discord and any website. Offline after a pack downloads. No API keys.",
  "version": "0.0.0",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Brainbox Translate", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "contextMenus", "offscreen", "sidePanel", "clipboardWrite", "scripting", "activeTab"],
  "optional_permissions": ["clipboardRead"],
  "host_permissions": [
    "https://discord.com/*",
    "https://storage.googleapis.com/moz-fx-translations-data--303e-prod-translations-data/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    { "matches": ["https://discord.com/*"], "js": ["content-discord.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "commands": {
    "translate-page": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Translate this page / show original" },
    "clipboard-translate": { "description": "Translate the clipboard (Clipboard mode)" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "web_accessible_resources": [{ "resources": ["icons/icon-48.png"], "matches": ["https://discord.com/*"] }]
}
