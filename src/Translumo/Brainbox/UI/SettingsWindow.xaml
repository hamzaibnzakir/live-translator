<Window
    x:Class="Brainbox.Desktop.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Brainbox Settings"
    Width="900"
    Height="680"
    MinWidth="760"
    MinHeight="520"
    Background="#0D0F14"
    FontFamily="Segoe UI Variable Display, Segoe UI"
    Icon="/Resources/Brainbox/brainbox.ico"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Brainbox/UI/BrainboxTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style BasedOn="{StaticResource BbCombo}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource BbTextBox}" TargetType="TextBox" />
            <Style BasedOn="{StaticResource BbSwitch}" TargetType="CheckBox" />
            <Style BasedOn="{StaticResource BbSlider}" TargetType="Slider" />
            <Style x:Key="Page" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Padding" Value="28,24,28,28" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  navigation  -->
        <Border Background="{StaticResource BbSurface}" BorderBrush="{StaticResource BbBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel Margin="6,0,0,22" DockPanel.Dock="Top" Orientation="Horizontal">
                    <Image Width="28" Height="28" Source="/Resources/Brainbox/brainbox.png" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource BbText}" Text="Brainbox" />
                        <TextBlock FontSize="11" Foreground="{StaticResource BbMuted}" Text="Settings" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource BbHint}"
                    Text="Changes are saved automatically." />
                <StackPanel>
                    <RadioButton x:Name="NavTranslation" Checked="OnNav" Content="Translation" GroupName="nav" IsChecked="True" Style="{StaticResource BbNavItem}" Tag="PageTranslation" />
                    <RadioButton Checked="OnNav" Content="Screen" GroupName="nav" Style="{StaticResource BbNavItem}" Tag="PageScreen" />
                    <RadioButton Checked="OnNav" Content="Performance" GroupName="nav" Style="{StaticResource BbNavItem}" Tag="PagePerformance" />
                    <RadioButton Checked="OnNav" Content="Overlay" GroupName="nav" Style="{StaticResource BbNavItem}" Tag="PageOverlay" />
                    <RadioButton Checked="OnNav" Content="Startup" GroupName="nav" Style="{StaticResource BbNavItem}" Tag="PageStartup" />
                    <RadioButton Checked="OnNav" Content="Hotkeys" GroupName="nav" Style="{StaticResource BbNavItem}" Tag="PageHotkeys" />
                    <RadioButton Checked="OnNav" Content="Advanced" GroupName="nav" Style="{StaticResource BbNavItem}" Tag="PageAdvanced" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <!--  ============ Translation ============  -->
            <ScrollViewer x:Name="PageTranslation" Style="{StaticResource Page}">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource BbSectionTitle}" Text="Translation" />
                    <TextBlock Style="{StaticResource BbHint}" Text="Foreign text anywhere on screen is translated into your target language. Text already in that language is ignored." />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Source language" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding SourceLanguages}" SelectedValue="{Binding Settings.SourceLanguage}" SelectedValuePath="Value" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Target language" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding TargetLanguages}" SelectedValue="{Binding Settings.TargetLanguage}" SelectedValuePath="Value" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Translation engine" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding Engines}" SelectedValue="{Binding Settings.Engine}" SelectedValuePath="Value" />

                    <StackPanel Visibility="{Binding IsLmStudio, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BbFieldLabel}" Text="LM Studio server" />
                        <TextBox Text="{Binding Settings.LmStudioEndpoint, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource BbHint}" Text="In LM Studio open Developer → Start Server. Default: http://localhost:1234/v1" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsOllama, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BbFieldLabel}" Text="Ollama server" />
                        <TextBox Text="{Binding Settings.OllamaEndpoint, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource BbHint}" Text="Default: http://localhost:11434/v1 (OpenAI-compatible endpoint)." />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BbFieldLabel}" Text="API endpoint" />
                        <TextBox Text="{Binding Settings.CustomEndpoint, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource BbFieldLabel}" Text="API key (optional, stored encrypted)" />
                        <PasswordBox
                            x:Name="ApiKeyBox"
                            Height="36"
                            Padding="10,8"
                            Background="{StaticResource BbSurface2}"
                            BorderBrush="{StaticResource BbBorder}"
                            Foreground="{StaticResource BbText}"
                            PasswordChanged="OnApiKeyChanged" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsTranslumo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BbHint}" Text="Uses the active LLM profile from the classic Translumo settings (DeepSeek, GPT, Claude, Gemini, Qwen…). Configure it under Advanced → Classic Translumo settings." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsAiEngine, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BbFieldLabel}" Text="Model" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox IsEditable="True" ItemsSource="{Binding Models}" Text="{Binding Settings.Model, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="2" Click="OnRefreshModels" Content="Refresh models" Style="{StaticResource BbGhostButton}" />
                        </Grid>
                        <TextBlock Style="{StaticResource BbHint}" Text="{Binding ModelStatus}" />

                        <TextBlock Style="{StaticResource BbFieldLabel}" Text="{Binding ContextSizeText}" />
                        <Slider IsSnapToTickEnabled="True" Maximum="20" Minimum="0" TickFrequency="1" Value="{Binding Settings.ContextSize}" />
                        <TextBlock Style="{StaticResource BbHint}" Text="Earlier subtitles/dialogue sent along so pronouns, names and tone stay consistent. 0 = off." />
                    </StackPanel>

                    <CheckBox Margin="0,18,0,0" Content="Fall back to Google Translate when the local engine is unavailable" IsChecked="{Binding Settings.CloudFallback}" />
                    <TextBlock Style="{StaticResource BbHint}" Text="Off by default: with it on, screen text may be sent to Google when LM Studio/Ollama is closed." />
                </StackPanel>
            </ScrollViewer>

            <!--  ============ Screen ============  -->
            <ScrollViewer x:Name="PageScreen" Style="{StaticResource Page}" Visibility="Collapsed">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource BbSectionTitle}" Text="Screen" />
                    <TextBlock Style="{StaticResource BbHint}" Text="Which displays Brainbox watches. Coordinates follow the Windows virtual desktop, so mixed resolutions, DPI scaling and portrait monitors are handled." />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Monitor" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding Scopes}" SelectedValue="{Binding Settings.ScreenScope}" SelectedValuePath="Value" />

                    <StackPanel Visibility="{Binding IsSpecificMonitor, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BbFieldLabel}" Text="Specific monitor" />
                        <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding Monitors}" SelectedValue="{Binding Settings.SpecificMonitor}" SelectedValuePath="Value" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Detected monitors" />
                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2" Foreground="{StaticResource BbMuted}" Text="{Binding Display}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Virtual desktops" />
                    <CheckBox Content="Keep translating when I switch Windows virtual desktops" IsChecked="{Binding Settings.FollowVirtualDesktops}" />
                    <TextBlock Style="{StaticResource BbHint}" Text="The overlay and glow move with you to the active desktop and the new desktop is scanned immediately." />
                </StackPanel>
            </ScrollViewer>

            <!--  ============ Performance ============  -->
            <ScrollViewer x:Name="PagePerformance" Style="{StaticResource Page}" Visibility="Collapsed">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource BbSectionTitle}" Text="Performance" />
                    <TextBlock Style="{StaticResource BbHint}" Text="Brainbox only runs OCR on parts of the screen that changed, and only translates text it has not seen before." />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Mode" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding Modes}" SelectedValue="{Binding Settings.PerformanceMode}" SelectedValuePath="Value" />
                    <TextBlock Style="{StaticResource BbHint}" Text="{Binding ModeDescription}" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="{Binding IntervalText}" />
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="3000"
                        Minimum="0"
                        TickFrequency="50"
                        Value="{Binding Settings.DetectionIntervalMs}" />
                    <TextBlock Style="{StaticResource BbHint}" Text="0 = use the mode's interval." />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="{Binding SensitivityText}" />
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="10"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{Binding Settings.Sensitivity}" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="OCR engine" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding OcrEngines}" SelectedValue="{Binding Settings.OcrEngine}" SelectedValuePath="Value" />
                    <TextBlock Style="{StaticResource BbHint}" Text="{Binding OcrLanguagesText}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="OcrInstallCombo" DisplayMemberPath="Display" ItemsSource="{Binding InstallableOcrLanguages}" SelectedValuePath="Value" />
                        <Button Grid.Column="2" Click="OnInstallOcr" Content="Install OCR language" Style="{StaticResource BbGhostButton}" />
                    </Grid>

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Capture (CPU / GPU preference)" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding CaptureBackends}" SelectedValue="{Binding Settings.CaptureBackend}" SelectedValuePath="Value" />

                    <CheckBox Margin="0,16,0,0" Content="Vision model fallback when OCR can't read text (Maximum Accuracy)" IsChecked="{Binding Settings.VisionFallback}" />
                    <TextBlock Style="{StaticResource BbHint}" Text="Needs a vision-capable model (e.g. Qwen2.5-VL, LLaVA, Gemma 3). Rate-limited to keep the PC responsive." />
                </StackPanel>
            </ScrollViewer>

            <!--  ============ Overlay ============  -->
            <ScrollViewer x:Name="PageOverlay" Style="{StaticResource Page}" Visibility="Collapsed">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource BbSectionTitle}" Text="Overlay" />
                    <TextBlock Style="{StaticResource BbHint}" Text="Translations are drawn over the original text, never block the mouse or keyboard, and are invisible to screenshots." />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Position behaviour" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding Styles}" SelectedValue="{Binding Settings.OverlayStyle}" SelectedValuePath="Value" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Background" />
                    <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding Backgrounds}" SelectedValue="{Binding Settings.OverlayBackground}" SelectedValuePath="Value" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="{Binding OpacityText}" />
                    <Slider Maximum="1" Minimum="0.3" Value="{Binding Settings.OverlayOpacity}" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Font" />
                    <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding Settings.FontFamily}" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="{Binding FontSizeText}" />
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="48"
                        Minimum="0"
                        TickFrequency="1"
                        Value="{Binding Settings.FontSize}" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Live glow" />
                    <CheckBox Content="Show the Brainbox glow around the screen while translating" IsChecked="{Binding Settings.GlowEnabled}" />
                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="{Binding GlowText}" />
                    <Slider Maximum="1" Minimum="0.05" Value="{Binding Settings.GlowIntensity}" />
                </StackPanel>
            </ScrollViewer>

            <!--  ============ Startup ============  -->
            <ScrollViewer x:Name="PageStartup" Style="{StaticResource Page}" Visibility="Collapsed">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource BbSectionTitle}" Text="Startup" />
                    <CheckBox Content="Start Brainbox Translator with Windows" IsChecked="{Binding Settings.StartWithWindows}" />
                    <CheckBox Content="Automatically enable translation when Brainbox starts" IsChecked="{Binding Settings.AutoEnableOnStart}" />
                    <CheckBox Content="Start minimized to the tray" IsChecked="{Binding Settings.StartMinimized}" />
                    <TextBlock Style="{StaticResource BbHint}" Text="{Binding StartupStatus}" />
                </StackPanel>
            </ScrollViewer>

            <!--  ============ Hotkeys ============  -->
            <ScrollViewer x:Name="PageHotkeys" Style="{StaticResource Page}" Visibility="Collapsed">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource BbSectionTitle}" Text="Hotkeys" />
                    <TextBlock Style="{StaticResource BbHint}" Text="Optional — Brainbox works automatically without them. Format: Ctrl+Alt+B, Ctrl+Shift+F9, Win+Alt+T…" />
                    <CheckBox Margin="0,14,0,0" Content="Enable global hotkeys" IsChecked="{Binding Settings.HotkeysEnabled}" />
                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Toggle translator" />
                    <TextBox Text="{Binding Settings.HotkeyToggle, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Pause translation" />
                    <TextBox Text="{Binding Settings.HotkeyPause, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Toggle glow" />
                    <TextBox Text="{Binding Settings.HotkeyGlow, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Foreground="{StaticResource BbAmber}" Style="{StaticResource BbHint}" Text="{Binding Controller.HotkeyErrors}" />
                </StackPanel>
            </ScrollViewer>

            <!--  ============ Advanced ============  -->
            <ScrollViewer x:Name="PageAdvanced" Style="{StaticResource Page}" Visibility="Collapsed">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource BbSectionTitle}" Text="Advanced" />
                    <CheckBox Content="Logging" IsChecked="{Binding Settings.LoggingEnabled}" />
                    <CheckBox Content="Debug mode (verbose logs)" IsChecked="{Binding Settings.DebugMode}" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Translation cache" />
                    <TextBlock Style="{StaticResource BbHint}" Text="{Binding CacheText}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Click="OnClearCache" Content="Clear cache" Style="{StaticResource BbGhostButton}" />
                        <Button Margin="10,0,0,0" Click="OnOpenLogs" Content="Open logs folder" Style="{StaticResource BbGhostButton}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Request timeout (seconds)" />
                    <TextBox Text="{Binding Settings.RequestTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Live metrics" />
                    <TextBlock Style="{StaticResource BbHint}" Text="{Binding Controller.MetricsText}" />

                    <TextBlock Style="{StaticResource BbFieldLabel}" Text="Tools" />
                    <WrapPanel>
                        <Button Margin="0,0,10,10" Click="OnClassicSettings" Content="Classic Translumo settings" Style="{StaticResource BbGhostButton}" />
                        <Button Margin="0,0,10,10" Click="OnRunSelfTest" Content="Run screen self-test" Style="{StaticResource BbGhostButton}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource BbHint}" Text="Self-test opens a test window with foreign text, verifies detection, translation, overlay placement, click-through and recursion protection, and writes a report next to the logs." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
